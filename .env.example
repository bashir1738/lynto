# Lynto environment configuration
# Copy to .env and fill in real values. Never commit .env or real secrets.

# --- Database ---
DATABASE_URL="postgresql://lynto:lynto@localhost:5432/lynto"

# --- Arc network ---
# 5042 = Arc mainnet, 5042002 = Arc testnet
ARC_CHAIN_ID="5042"
ARC_RPC_URL="https://rpc.mainnet.arc.io"

# --- Deployed contract ---
# Set after deploying contracts/src/LyntoPayments.sol
LYNTO_CONTRACT_ADDRESS=""
NEXT_PUBLIC_LYNTO_CONTRACT_ADDRESS=""

# --- USDC on Arc (verified official address — same on mainnet/testnet) ---
NEXT_PUBLIC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# --- Settlement operator (server-side only; NEVER expose to browser) ---
# Private key of the address authorized via setOperator() on the contract.
OPERATOR_PRIVATE_KEY=""

# --- Provider ---
# Onchain address that receives settled USDC payments.
PROVIDER_ADDRESS=""

# --- Contract owner ---
OWNER_ADDRESS=""

# --- Metering / settlement config ---
# Auto-settle after this many accrued successful calls
SETTLE_THRESHOLD_CALLS="100"
# Minimum accrued amount (base units, 6 decimals) before onchain reserve sync
RESERVE_SYNC_THRESHOLD="50000"

# --- Demo agent ---
# Base URL of the Lynto app (for the demo agent to call paid endpoints)
LYNTO_APP_URL="http://localhost:3000"
# Demo agent wallet address (must match the onchain prepaid account)
DEMO_AGENT_WALLET_ADDRESS=""
# Demo agent API key (returned once when the agent is registered)
DEMO_AGENT_API_KEY=""
# Number of paid calls for the demo agent to make
DEMO_AGENT_CALLS="50"
# Spending limit in base units (6 decimals) — demo agent stops at this spend
DEMO_AGENT_SPEND_LIMIT="100000"

# --- WalletConnect (optional, for mobile wallets) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# --- Build/deploy ---
# For forge verify (optional)
ETHERSCAN_API_KEY=""
